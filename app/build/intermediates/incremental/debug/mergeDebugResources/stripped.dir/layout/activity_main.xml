<?xml version="1.0" encoding="utf-8"?>
<!-- Bước 2: Thiết kế giao diện — đúng theo slide Phần 8 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#1B2631">

    <!-- Khung Card chứa thông tin sinh viên -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#243342">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Avatar bo tròn sử dụng ShapeableImageView -->

            <!-- Tên sinh viên -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="Avatar sinh viên"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/my_avatar"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#34B469"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />

            <!-- MSSV + Lớp -->
            <TextView
                android:id="@+id/tvStudentId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#DCE6EB"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- GPA Badge -->
            <TextView
                android:id="@+id/tvGpaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#34B469"
                android:layout_marginTop="12dp" />

            <!-- EditText nhập GPA mới -->
            <EditText
                android:id="@+id/edtNewGpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập GPA mới (0.0 - 4.0)"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A9BB0"
                android:backgroundTint="#34B469"
                android:layout_marginTop="16dp" />

            <!-- Nút Cập Nhật -->
            <Button
                android:id="@+id/btnUpdateGpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cập Nhật Thông Tin"
                android:backgroundTint="#34B469"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
